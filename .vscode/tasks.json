{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "콘솔을 통한 시각화 기능이 포함된 빌드(need archive)",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fdiagnostics-color=always",
                "-g",
                "UI_main.c",
                "data_structure/my_list.c",
                "UI_util.c",
                "push_swap.a",
                "-o",
                "${fileDirname}/a.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "디버거에서 생성된 작업입니다."
        },
        {
            "type": "cppbuild",
            "label": "과제 제출용 프로그램 빌드",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-Werror",
                "-fdiagnostics-color=always",
                "-g",
                "main.c",
                "command/custom_command.c",
                "command/push.c",
                "data_structure/my_list.c",
                "subject_init.c",
                "simple_sort.c",
                "push_swap.a",
                "-o",
                "${fileDirname}/a.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "디버거에서 생성된 작업입니다."
        }
    ],
    "version": "2.0.0"
}